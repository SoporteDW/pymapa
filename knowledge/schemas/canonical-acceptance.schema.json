{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aceptación canónica humana de un candidato",
  "description": "Contrato autoritativo: canonicalAcceptanceSchema (packages/knowledge-pipeline/src/candidate.ts). Solo la registra una persona; la Factory nunca la genera.",
  "type": "object",
  "required": ["capabilityId", "candidateChecksum", "decision", "reviewer", "reviewedAt"],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z]{2}-\\d{2}$"
    },
    "candidateChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "enum": ["ACCEPTED", "REJECTED", "CHANGES_REQUESTED"]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
