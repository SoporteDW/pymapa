        ]
      }
    },
    {
      "key": "REASS-PC02-01",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_REASS",
      "sourceId": "REASS-PC02-01",
      "fields": {
        "heading": "REASS-PC02-01",
        "body": [
          "Una competencia validada no debe considerarse permanentemente vigente si cambia materialmente el contexto en que se utiliza."
        ]
      },
