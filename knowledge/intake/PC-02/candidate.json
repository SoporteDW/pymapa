        ]
      }
    },
    {
      "key": "CE06",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_CE",
      "sourceId": "CE06",
      "fields": {
        "heading": "CE06 · Mantenimiento/adaptación",
        "title": "Mantenimiento/adaptación",
        "body": [
          "VA12 · Refuerzo o continuidad cuando la competencia lo requiere",
          "VA13 · Actualización frente a cambios materiales",
          "Una competencia digital válida hoy puede deteriorarse rápidamente si cambia tecnología, proceso o contexto."
        ]
      },
      "sourceLines": [
        172,
        175
      ],
      "approvalEvidence": {
        "text": "PC02-K4-v1.0 · K4-VALIDATED · CLOSED",
        "sourceLines": [
