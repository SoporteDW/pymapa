    {
      "key": "V2",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_V",
      "sourceId": "V2",
      "fields": {
        "heading": "V2 · Competence demonstrated",
        "title": "Competence demonstrated",
        "body": [
          "La persona demuestra suficientemente la capacidad en una situación representativa."
        ]
      },
      "sourceLines": [
        577,
        578
      ],
      "approvalEvidence": {
