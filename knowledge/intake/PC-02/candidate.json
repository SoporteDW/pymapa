    {
      "key": "V3",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_V",
      "sourceId": "V3",
      "fields": {
        "heading": "V3 · Competence sustained",
        "title": "Competence sustained",
        "body": [
          "La competencia continúa siendo demostrable cuando su naturaleza requiere recurrencia o sostenibilidad.",
          "No toda competencia requiere V3."
        ]
      },
      "sourceLines": [
        579,
        581
      ],
      "approvalEvidence": {
