      "fields": {
        "heading": "CE01 · Identificación de necesidades de conocimiento",
        "title": "Identificación de necesidades de conocimiento",
        "body": [
          "VA01 · Necesidades de conocimiento material reconocidas",
          "VA02 · Relación necesidad–decisión/actividad/resultado",
          "No queremos inventarios abstractos de conocimiento.",
          "Queremos saber:",
          "¿para qué necesita saber esto la organización?"
        ]
      },
