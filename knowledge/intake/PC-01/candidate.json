    {
      "key": "CE04",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_CE",
      "sourceId": "CE04",
      "fields": {
        "heading": "CE04 · Calidad y utilidad",
        "title": "Calidad y utilidad",
        "body": [
          "VA07 · Pertinencia para la necesidad",
          "VA08 · Confiabilidad suficiente",
          "VA09 · Utilizabilidad/comprensibilidad",
          "Aquí debemos evitar una trampa:",
          "conocimiento disponible ≠ conocimiento utilizable."
        ]
      },
      "sourceLines": [
        143,
        148
      ],
      "approvalEvidence": {
