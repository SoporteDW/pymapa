    {
      "key": "CE05",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_CE",
      "sourceId": "CE05",
      "fields": {
        "heading": "CE05 · Adecuación del mecanismo de provisión",
        "title": "Adecuación del mecanismo de provisión",
        "body": [
          "VA10 · Adecuación internalizar vs acceder externamente",
          "VA11 · Sostenibilidad del acceso cuando la necesidad es recurrente/material",
          "Esta CE será particularmente útil para pymes.",
          "No preguntaremos:",
          "“¿Tiene un experto en plantilla?”",
          "Preguntaremos:",
          "¿puede obtener de manera suficientemente confiable el conocimiento cuando lo necesita?"
        ]
      },
      "sourceLines": [
        150,
        157
      ],
      "approvalEvidence": {
