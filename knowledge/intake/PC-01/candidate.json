    },
    {
      "key": "CE03",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_CE",
      "sourceId": "CE03",
      "fields": {
        "heading": "CE03 · Acceso oportuno",
        "title": "Acceso oportuno",
        "body": [
          "VA05 · Accesibilidad efectiva",
          "VA06 · Oportunidad respecto de la necesidad",
          "Una respuesta correcta que llega después de la decisión puede no tener valor operativo."
        ]
      },
      "sourceLines": [
        138,
        141
      ],
      "approvalEvidence": {
        "text": "PC01-K4-v1.0 · K4-VALIDATED · CLOSED",
