    {
      "key": "REC-PC03-01",
      "classification": "FINAL_APPROVED",
      "objectType": "SOURCE_ID_REC",
      "sourceId": "REC-PC03-01",
      "fields": {
        "heading": "REC-PC03-01",
        "body": [
          "La intervención debe dirigirse a la barrera causal con mayor evidencia y no automáticamente a las personas.",
          "Por tanto:",
          "competencia insuficiente → PC-02",
          "proceso mal diseñado → OP",
          "tecnología inadecuada → DT",
          "autoridad ambigua → DG-03",
          "comprensión/adopción/apropiación → PC-03",
          "participación/adaptación más amplia → PC-05"
        ]
      },
      "sourceLines": [
