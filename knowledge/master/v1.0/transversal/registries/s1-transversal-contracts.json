    "contracts": [
      {
        "id": "MOTOR-CONTRACT-01",
        "sourceReference": "S1.16",
        "statement": "Non-applicable does not penalize sufficiency, confidence or capability state."
      },
      {
        "id": "MOTOR-CONTRACT-02",
        "sourceReference": "S1.17",
        "statement": "Every material inference must be traceable to observations + rules."
      },
      {
        "id": "MOTOR-CONTRACT-03",
        "sourceReference": "S1.18",
        "statement": "Capability-specific ladders must declare what each state validates and the semantic difference between states."
      },
      {
        "id": "MOTOR-CONTRACT-04",
        "sourceReference": "S1.20",
        "statement": "Sufficiency ≠ completeness."
      },
      {
        "id": "MOTOR-CONTRACT-05",
        "sourceReference": "S1.21",
        "statement": "Confidence belongs to a specific claim, observation, finding, causal relation or validation. Never to the whole company. Sufficiency ≠ confidence. Required confidence depends on consequence and reversibility."
      },
      {
        "id": "MOTOR-CONTRACT-06",
        "sourceReference": "S1.27",
        "statement": "A recommendation enters the roadmap only when sufficiently specified as an intervention."
      },
      {
        "id": "MOTOR-CONTRACT-07",
        "sourceReference": "S1.27",
        "statement": "Done Criteria do not close a finding without CRV validation. CRV ≠ KPI."
      },
      {
        "id": "MOTOR-CONTRACT-08",
        "sourceReference": "S1.28",
        "statement": "V0–V4 ≠ universal maturity scale."
      },
      {
        "id": "MOTOR-CONTRACT-09",
        "sourceReference": "S1.30",
        "statement": "A case pattern never becomes a Master rule automatically."
      },
      {
        "id": "MOTOR-CONTRACT-10",
        "sourceReference": "S1.32",
        "statement": "Positive state requires positive evidence."
      },
      {
        "id": "MOTOR-CONTRACT-11",
        "sourceReference": "S1.32",
        "statement": "UNKNOWN is a valid epistemic state, not BAD."
      },
      {
        "id": "MOTOR-CONTRACT-12",
        "sourceReference": "S1.32",
        "statement": "Historical state is not indefinitely current."
      },
      {
        "id": "MOTOR-CONTRACT-13",
        "sourceReference": "S1.32",
        "statement": "Do not generalize beyond evidence scope. Population/sample scope must be preserved."
      },
      {
        "id": "MOTOR-CONTRACT-14",
        "sourceReference": "S1.32",
        "statement": "Evidence depth can increase with materiality + consequence + irreversibility."
      },
      {
        "id": "MOTOR-CONTRACT-15",
        "sourceReference": "S1.32",
        "statement": "Specialist escalation is based on expertise + consequence + professional boundary + complexity + uncertainty + economics + failed self-resolution. Output must specify expertise + purpose + outcome."
      },
      {
        "id": "MOTOR-CONTRACT-16",
        "sourceReference": "S1.32",
        "statement": "Material recommendation is incomplete without a traceable, understandable explanation."
      },
      {
        "id": "MOTOR-CONTRACT-17",
        "sourceReference": "S1.32",
        "statement": "Historical diagnosis must be reconstructable using the Knowledge Version in force."
      },
      {
        "id": "MOTOR-CONTRACT-18",
        "sourceReference": "S1.32",
        "statement": "Material state must support reassessment triggers."
      }
    ],
    "evidenceReasoningChain": {
      "sourceReference": "S1.17",
      "definitions": {
        "Evidence": "source/object",
        "Observation": "condition extracted from evidence",
        "Inference": "rule-derived interpretation"
      },
      "note": "S1 enfatiza Evidence → Observation → Inference → Finding. S3 incorpora Claim como objeto explícito. La diferencia se preserva en CROSS-STAGE-DIFFERENCES."
    },
