    "versioning": {
      "sourceReference": "S4.8",
      "scheme": "MAJOR.MINOR.PATCH",
      "mapping": [
        "PATCH generally corresponds to CH0.",
        "MINOR generally corresponds to CH1–CH2.",
        "MAJOR generally corresponds to CH3–CH4 where semantics/compatibility change."
      ],
      "examples": [
        "DT02-KP-v1.2.0",
        "PYMAPA-KM-v1.0.0"
      ],
      "engineVersion": "PYMAPA-ENGINE-v1.x (separate)",
