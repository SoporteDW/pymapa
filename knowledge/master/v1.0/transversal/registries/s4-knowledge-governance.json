        "master_knowledge_version",
        "engine_version",
        "pack versions"
      ],
      "rules": [
        {
          "id": "KG-RULE-06",
          "statement": "Case Snapshot identifies both Engine and Knowledge versions used."
        }
      ]
    },
    "compatibilityAndMigration": {
      "sourceReference": "S4.9",
      "compatibility": [
        "COMPATIBLE",
        "INTERPRETATION-CHANGED",
        "BREAKING"
      ],
      "migration": [
        "NO-MIGRATION",
        "RECOMPUTE-OPTIONAL",
        "REASSESSMENT-REQUIRED"
      ],
      "rules": [
        {
          "id": "KG-RULE-07",
          "statement": "Never silently recompute historical diagnosis using new rules and present it as the original diagnosis."
        }
      ]
    },
    "learningGovernance": {
      "sourceReference": "S4.10",
      "flow": [
        "CASE LEARNING",
        "REUSABLE SIGNAL",
        "CANDIDATE KNOWLEDGE",
        "KCR",
        "REVIEW",
        "APPROVED KNOWLEDGE"
      ],
      "promotionCriteria": [
        "repeatability",
        "generalizability",
        "plausibility",
        "value",
        "non-contradiction",
        "provenance"
      ],
      "rules": [
        {
          "id": "KG-RULE-08",
          "statement": "Repetition strengthens a candidate but is not mandatory when a single case reveals sufficiently clear error/risk/contradiction."
        },
        {
          "id": "KG-RULE-09",
          "statement": "No automatic production rule mutation from aggregate user behavior."
        }
      ]
    },
    "aiGovernance": {
      "sourceReference": "S4.11",
      "aiCan": [
        "discover",
        "summarize",
        "compare",
        "suggest",
        "map",
        "draft"
      ],
      "aiCannotAutonomously": [
        "approve CH2–CH4",
        "publish a material source",
        "change diagnostic rules",
        "deprecate capability",
        "alter material CRV",
        "promote case signal to Master Knowledge"
      ],
      "rules": [
        {
          "id": "KG-RULE-10",
          "statement": "AI-proposed references must be verified for existence, identity and relevance before entering verified Source Register."
        }
      ]
