    "governingRules": {
      "sourceReference": "S3.1",
      "rules": [
        {
          "id": "OBJ-RULE-01",
          "statement": "Each master object has one primary semantic responsibility."
        },
        {
          "id": "OBJ-RULE-02",
          "statement": "Master Knowledge, Case State, Execution State and Learning State have separate identities/lifecycles."
        },
        {
          "id": "OBJ-RULE-03",
          "statement": "Respondent routing relates to Information Needs and does not change enterprise ownership of diagnosis."
        },
        {
          "id": "OBJ-RULE-04",
          "statement": "Aggregation to capability/domain/company only when scope, period and semantics support valid interpretation."
        },
        {
          "id": "OBJ-RULE-05",
          "statement": "Published diagnosis reconstructable from Case Snapshot + Knowledge Version."
        },
        {
          "id": "OBJ-RULE-06",
          "statement": "AI origin changes provenance/confidence/review, not object semantics."
        }
      ],
      "invariants": [
        "State ≠ object.",
        "Evidence ≠ conclusion.",
        "Knowledge ≠ Case.",
        "Specific objects may extend generic objects.",
        "Relations are first-class."
      ]
