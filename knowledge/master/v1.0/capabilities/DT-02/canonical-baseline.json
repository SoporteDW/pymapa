      "sourceId": "REASS-DT02-01",
      "fields": {
        "heading": "REASS-DT02-01",
        "body": [
          "Una conclusión de fitness-for-use debe reevaluarse cuando cambien materialmente el uso, requisito, fuente, transformación o mecanismo de mantenimiento del dato."
        ]
      },
      "sourceLines": [
        837,
        838
