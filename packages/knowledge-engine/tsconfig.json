{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@pymapa/knowledge-schema": [
        "../knowledge-schema/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}
