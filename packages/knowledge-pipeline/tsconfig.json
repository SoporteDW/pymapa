{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@pymapa/knowledge-schema": ["../knowledge-schema/src/index.ts"],
      "@pymapa/knowledge-engine": ["../knowledge-engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
